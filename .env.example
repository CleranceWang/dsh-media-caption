# dsh-media-eye 环境变量样例
#
# 用法：复制为 .env.local（已被 .gitignore 忽略），按你的机器填。
# 也可以不写文件，直接在 shell 里 export。
#
# 优先级：环境变量 > ~/.dsh/media-eye.config.json > 下面这些默认值

# ── 输入根 ──────────────────────────────────────
# 哨兵扫这里，找「笔记目录」（目录名末尾是 note_id / bv 号）
# 每个笔记目录下可有 video/ 或 audio/ 子目录
#     本机： D:/media/in
#     网络： //192.168.50.7/dsh-cache/media2doc/input
export MEDIA_EYE_INPUT_ROOT="D:/media/in"

# ── 输出根 ──────────────────────────────────────
# 产物落 <输出根>/<笔记目录名>/
#   ├── 字幕.json     转写结果（毫秒整数 + speech/language）
#   ├── frames.json   抽帧时间点
#   ├── frames/       f00.jpg … fNN.jpg（单帧原始分辨率）
#   ├── previews/     sheet.jpg 或 sheet-1..N.jpg（九宫格）
#   └── audio/        audio.wav（续跑用，删了会重抽）
#
#     标准面：同是 media2doc 下的 output
#     直给面：任意目录，裸文件落 <输出根>/_direct/<id>/
export MEDIA_EYE_OUT_ROOT="D:/media/out"

# ── 队列数据库 ──────────────────────────────────
# 必须在本机（不要放网络盘，SQLite 跨网络会锁坏）
# 不填则默认 ~/.dsh/media-eye/queue.db
# export MEDIA_EYE_DB="D:/media/queue.db"

# ── ASR ─────────────────────────────────────────
# faster-whisper-xxl 可执行文件
# Windows 示例：D:/Program Files/DAUM/PotPlayer/Engine/Faster-Whisper-XXL/faster-whisper-xxl.exe
export MEDIA_EYE_WHISPER="D:/path/to/faster-whisper-xxl.exe"

# large-v3 模型目录（约 3 GB）
# 下载：https://www.modelscope.cn/models/Systran/faster-whisper-large-v3
#   或：https://huggingface.co/Systran/faster-whisper-large-v3/tree/main
# 下下来是一个目录（model.bin / config.json / tokenizer.json …），填这个目录的路径
export MEDIA_EYE_MODEL_DIR="D:/path/to/faster-whisper-large-v3"

# 必须是 ffmpeg / ffprobe 所在目录，或已在 PATH 里
# export MEDIA_EYE_FFMPEG_DIR="C:/ffmpeg/bin"

# ── 抽帧 ────────────────────────────────────────
# 帧数上下限：N = clamp(round(变化点数 / 8), N_MIN, N_MAX)
#   9  = 一屏九宫格（短视频）
#   27 = 三屏（2 小时以内的长视频）
# export MEDIA_EYE_N_MIN=9
# export MEDIA_EYE_N_MAX=27
# export MEDIA_EYE_TILE=720

# ── 队列 ────────────────────────────────────────
# 即时通道的队列号（哨兵发现的活进哪个队列）
# export MEDIA_EYE_QUEUE_NO=0
# 同一单最多重试几次
# export MEDIA_EYE_MAX_TRIES=3
# 「处理中」多久算超时（分钟），防止进程崩了单子卡死
# export MEDIA_EYE_CLAIM_TIMEOUT_MIN=30

# ── 定时器 ──────────────────────────────────────
# 哨兵多久扫一轮（秒）。NAS 上 683 个目录约 1.5 秒，30 秒够用
# export MEDIA_EYE_SENTINEL_SEC=30
# 传话筒多久查一次 DB（秒）
# export MEDIA_EYE_WATCH_SEC=5

# ── 常驻开关（开关在配置文件里，不在这里）───────
# ★ 哨兵与传话筒默认都关：装上插件只会得到两个工具，不会自己去扫盘。
#   要「丢进输入目录就自动处理」，在 ~/.dsh/media-eye.config.json 写：
#     { "sentinel": true, "watcher": true }
#   这两个是布尔字段，没有对应的 MEDIA_EYE_* 环境变量。

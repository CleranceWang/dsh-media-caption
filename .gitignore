out-*/
in/
in-bare/
in-std/
_work/
last-manifest.json

# ─── 依赖 ──────────────────────────────────────
node_modules/
package-lock.json

# ─── 编辑器 / 系统 ─────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ─── 日志与临时文件 ────────────────────────────
*.log
tmp/
.tmp/
.verify-tmp/
